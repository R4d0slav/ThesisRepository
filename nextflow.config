/*═════════════════════════════════════════════════════════════════════════════╗
║              PSS KINETIC MODELLING PIPELINE  •  Configuration                ║
║                                                                              ║
║  Select a profile at runtime:  nextflow run main.nf -profile <name>          ║
║    local  →  laptop / workstation                                            ║
║    slurm  →  HPC cluster via SLURM scheduler                                 ║
╚═════════════════════════════════════════════════════════════════════════════*/


// ── Container / environment ───────────────────────────────────────────────────
docker.enabled = false
conda.enabled  = true


// ── Input paths ───────────────────────────────────────────────────────────────
params {
    data_path   = 'data/'
    script_path = 'scripts/modeling'
    events_path = "${params.data_path}/events"
    sim_conditions = null   // optional JSON file path
    subset      = 'all'          // reaction subset: all | ja | aba
    decay_form  = 'first-order'  // degradation law: first-order | saturating | saturating-global
                                 // 'saturating' = delta*s/(K+s) with K per species type
                                 // (median initial concentration of the type);
                                 // 'saturating-global' = legacy single K = 1e-4 mM

    // ── CVODE integrator tuning (null → keep solver defaults) ─────────────────
    rel_tol   = null        // relative tolerance, e.g. 1e-4 (looser) or 1e-8 (tighter)
    abs_tol   = null        // absolute tolerance, e.g. 1e-10
    max_steps = 50000       // max internal steps per output interval; robust default
                            // (solver default ~20000). Raise further for stiff runs.

    // ── Logging paths — override on the CLI with --log.trace_file etc. ────────
    log {
        dir           = "logs/"
        trace_file    = "${params.log.dir}/trace.tsv"
        report_file   = "${params.log.dir}/report.html"
        timeline_file = "${params.log.dir}/timeline.html"
    }
}


// ── Output ────────────────────────────────────────────────────────────────────
outputDir = 'results'

workflow {
    output.mode = 'copy'
}


// ══════════════════════════════════════════════════════════════════════════════
//  LOGGING  — trace, HTML report, and execution timeline
//  All three files land in logs/<run-name>/ so each run keeps its own folder.
// ══════════════════════════════════════════════════════════════════════════════

// Execution trace — one row per task with timing, CPU %, memory, I/O, exit code
trace {
    enabled   = true
    file      = "${params.log.trace_file}"
    overwrite = true

    // Columns written to the TSV (add/remove as needed)
    fields    = [
        'task_id', 'name', 'status', 'exit',
        'submit', 'start', 'complete', 'duration', 'realtime',
        'cpus', '%cpu', 'memory', '%mem',
        'rss', 'vmem', 'peak_rss', 'peak_vmem',
        'rchar', 'wchar',
        'workdir', 'script'
    ]
}

// HTML execution report — visual summary of all tasks
report {
    enabled   = true
    file      = "${params.log.report_file}"
    overwrite = true
}

// Gantt-style timeline — see which tasks ran in parallel and how long each took
timeline {
    enabled   = true
    file      = "${params.log.timeline_file}"
    overwrite = true
}


// ── Default process settings (fallback when no profile is active) ─────────────
process {
    executor = 'local'
    cpus     = 2

    // Capture stdout + stderr for every process into the work directory
    // (.command.log and .command.err are always written by Nextflow;
    //  these settings make the pipeline fail loudly on non-zero exit codes)
    errorStrategy = { task.exitStatus in [1, 2] ? 'terminate' : 'terminate' }
    maxRetries    = 0

    withName: 'simulatePSS' {
        cpus = 4                // ODE integration is CPU-bound; tune per machine
    }
}


/*═════════════════════════════════════════════════════════════════════════════╗
║  PROFILES                                                                    ║
╚═════════════════════════════════════════════════════════════════════════════*/

profiles {

    /*───────────────────────────────────────────────────────────────────┐
    │  local — laptop / workstation, conservative core count             │
    └───────────────────────────────────────────────────────────────────*/
    local {
        process {
            executor = 'local'
            cpus     = 2

            withName: 'simulatePSS' {
                cpus = 4           // allow more cores for the simulation step
            }
        }
    }

    /*───────────────────────────────────────────────────────────────────┐
    │  slurm — HPC cluster; adjust queue names and resources as needed   │
    └───────────────────────────────────────────────────────────────────*/
    slurm {
        process {
            executor = 'slurm'
            cpus     = 2
            queue    = 'normal'     // default partition for lightweight processes

            withName: 'simulatePSS' {
                cpus   = 4
                queue  = 'normal'   // change if simulatePSS targets a dedicated partition
                time   = '4h'
                memory = '16 GB'
            }
        }
    }

    /*───────────────────────────────────────────────────────────────────┐
    │  debug — same as local but with extra Nextflow verbosity flags     │
    │  Usage:  nextflow run main.nf -profile debug                       │
    └───────────────────────────────────────────────────────────────────*/
    debug {
        process {
            executor      = 'local'
            cpus          = 4
            errorStrategy = 'terminate'

            withName: 'simulatePSS' {
                cpus = 6
            }
        }

        // Print the full script and environment for every task
        env.NXF_DEBUG = '2'
    }
}